POST {{baseUrl}}/deviceManagement/virtualEndpoint/reports/getFrontlineReport
Content-type: application/json
Authorization: Bearer {{access_token}}

{
  "reportName": "frontlineLicenseUsageReport",
  "filter": "ServicePlanId eq 'dd3801e2-4aa1-4b16-a44b-243e55497584' and Timestamp ge datetime'2026-09-08T00:00:00.000Z' and ConcurrentAccessGroupId eq '00000000-0000-0000-0000-000000000000' and SkuLicenseCount eq -1",
  "select": [
    "ServicePlanId",
    "LicenseCount",
    "ClaimedLicenseCount",
    "Timestamp"
  ],
  "skip": 0,
  "top": 100
}